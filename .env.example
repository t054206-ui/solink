# ─────────────────────────────────────────────────────────────────────────────
# Solink environment variables
# Copy to .env.local for development. Set the same keys in Vercel → Settings →
# Environment Variables for deployment. NEVER commit real values.
# Anything left empty puts the corresponding feature into a clearly labeled
# "not connected" / placeholder state — nothing is faked.
# ─────────────────────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — database, auth, storage   [PLACEHOLDER: SUPABASE PROJECT]
# Without these, Solink runs in DEMO MODE (no accounts, labeled demo data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS. Used for hardware ingestion / imports / admin jobs.
SUPABASE_SERVICE_ROLE_KEY=

# Claude API — the AI layer for the Solar Agent, image inspection, recommendations,
# monitoring, placement and explanations.   [PLACEHOLDER: CLAUDE API KEY]  (server only)
# NOT used by Solar Site Analysis, which runs on Solink's own rules since 2026-09-22.
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-opus-5

# WeatherAPI.com — the selected weather provider   [PLACEHOLDER: WEATHER API KEY]  (server only)
WEATHER_API_KEY=

# Google Maps Platform   [PLACEHOLDER: GOOGLE MAPS API KEY]
# Server key (Geocoding API) — never exposed to the browser:
GOOGLE_MAPS_API_KEY=
# Browser key (Maps JavaScript API) — restrict by HTTP referrer in Google Cloud:
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
# Google Solar API — optional, only if access is confirmed. Solar Site Analysis runs
# without it and leaves roof measurements unavailable.   [PLACEHOLDER: GOOGLE SOLAR / SOLAR SITE DATA SOURCE]
GOOGLE_SOLAR_API_KEY=

# Rate-limit store — optional. Security fix, 2026-09-24: without this, the
# per-minute request limit on AI/weather/map calls is counted separately by
# each server instance instead of once, shared. Set by attaching a Redis
# store in Vercel → Storage → Create Database → a Redis provider (e.g.
# Upstash); Vercel fills these in automatically. Left empty, the app falls
# back to the old per-instance counter — it still runs, just less strictly.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Not yet selected — intentionally absent until a decision is made:
# [PLACEHOLDER: PAYMENT PROVIDER]
# [PLACEHOLDER: EMAIL / NOTIFICATION PROVIDER]
# [PLACEHOLDER: SOLAR MONITORING HARDWARE/API]
# [PLACEHOLDER: PANEL-LEVEL MONITORING DATA SOURCE]
# [PLACEHOLDER: OTHER REQUIRED KEYS]
