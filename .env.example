# ─────────────────────────────────────────────────────────────────────────────
# Solink environment variables
# Copy to .env.local for development. Set the same keys in Vercel → Settings →
# Environment Variables for deployment. NEVER commit real values.
# Anything left empty puts the corresponding feature into a clearly labeled
# "not connected" / placeholder state — nothing is faked.
# ─────────────────────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — database, auth, storage   [PLACEHOLDER: SUPABASE PROJECT]
# Without these, Solink runs in DEMO MODE (no accounts, labeled demo data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS. Used for hardware ingestion / imports / admin jobs.
SUPABASE_SERVICE_ROLE_KEY=

# Claude API — the central AI layer   [PLACEHOLDER: CLAUDE API KEY]  (server only)
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-opus-5

# WeatherAPI.com — the selected weather provider   [PLACEHOLDER: WEATHER API KEY]  (server only)
WEATHER_API_KEY=

# Google Maps Platform   [PLACEHOLDER: GOOGLE MAPS API KEY]
# Server key (Geocoding API) — never exposed to the browser:
GOOGLE_MAPS_API_KEY=
# Browser key (Maps JavaScript API) — restrict by HTTP referrer in Google Cloud:
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
# Google Solar API — only if access is confirmed   [PLACEHOLDER: GOOGLE SOLAR / SOLAR SITE DATA SOURCE]
GOOGLE_SOLAR_API_KEY=

# Not yet selected — intentionally absent until a decision is made:
# [PLACEHOLDER: PAYMENT PROVIDER]
# [PLACEHOLDER: EMAIL / NOTIFICATION PROVIDER]
# [PLACEHOLDER: SOLAR MONITORING HARDWARE/API]
# [PLACEHOLDER: PANEL-LEVEL MONITORING DATA SOURCE]
# [PLACEHOLDER: OTHER REQUIRED KEYS]
